# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Notas internas del docente (no se publican)
clase_11/simulacion/ABOUT.md
clase_15/ejemplos/NOVEDADES.md

# Bytecode de Python (se genera al importar módulos, p. ej. common.py)
__pycache__/
*.pyc

# Checkpoints de Jupyter
.ipynb_checkpoints/

# Ejecutables ELF sin extensión de clase_16/code/counters/ (traídos del
# semestre pasado o generados al compilar): se ignora todo archivo sin punto
# en el nombre, salvo los Makefile
clase_16/code/counters/**/*
!clase_16/code/counters/**/
!clase_16/code/counters/**/*.*
!clase_16/code/counters/**/Makefile
clase_16/code/counters/**/.ipynb_checkpoints/
